{
  "name": "drispro-server",
  "productName": "DrisPRO Server",
  "version": "1.0.4",
  "description": "Serveri DrisPRO për Windows: instalimi, gjendja, kopjet dhe riparimi.",
  "author": "DrisPRO",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node ../desktop/nsis-shqip.mjs && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.drispro.server",
    "productName": "DrisPRO Server",
    "artifactName": "DrisPRO-Server-Setup-${version}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "ui/**", "package.json"],
    "extraResources": [
      { "from": "engine", "to": "engine" },
      { "from": "bundle", "to": "bundle" },
      { "from": "build", "to": "build", "filter": ["*.png"] }
    ],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DrisPRO Server",
      "language": "1052",
      "guid": "2f6c1b7e-6a5e-5b1e-9d3c-7d1f3a0c4e21",
      "installerSidebar": "../desktop/build/installerSidebar.bmp",
      "uninstallerSidebar": "../desktop/build/uninstallerSidebar.bmp",
      "installerHeader": "../desktop/build/installerHeader.bmp",
      "installerLanguages": ["sq_AL"],
      "uninstallDisplayName": "DrisPRO Server",
      "runAfterFinish": true
    }
  }
}
