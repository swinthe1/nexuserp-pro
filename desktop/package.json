{
  "name": "drispro-desktop",
  "productName": "DrisPRO",
  "version": "1.4.0",
  "description": "DrisPRO për Windows: i gjithë aplikacioni, me printim direkt në printerët e kuponëve dhe të kuzhinës.",
  "author": "DrisPRO",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.drispro.desktop",
    "productName": "DrisPRO",
    "artifactName": "DrisPRO-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "activation.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DrisPRO",
      "language": "1052",
      "guid": "16ba544e-9015-5059-ab77-250c11fafbcc"
    }
  }
}
