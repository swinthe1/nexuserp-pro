{
  "name": "drispro-desktop",
  "productName": "DrisPRO",
  "version": "2.56.0",
  "description": "DrisPRO për Windows dhe Mac: i gjithë aplikacioni, me printim direkt në printerët e kuponëve dhe të kuzhinës.",
  "author": "DrisPRO",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node nsis-shqip.mjs && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac --universal --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.drispro.desktop",
    "productName": "DrisPRO",
    "artifactName": "DrisPRO-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "activation.html",
      "device.html",
      "support.html",
      "support-bar.html",
      "support-preload.js",
      "support-input.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DrisPRO",
      "language": "1052",
      "guid": "16ba544e-9015-5059-ab77-250c11fafbcc",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "sq_AL"
      ],
      "uninstallDisplayName": "DrisPRO"
    },
    "afterSign": "adhoc-sign.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.business",
      "artifactName": "DrisPRO-${version}-mac.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "11.0"
    },
    "dmg": {
      "artifactName": "DrisPRO-${version}.${ext}",
      "title": "DrisPRO ${version}",
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 600,
        "height": 400
      }
    }
  }
}
